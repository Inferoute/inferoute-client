# Copy to references/.env (same folder). NEVER commit filled secrets.

# JarvisLab — instance id is auto-discovered from `jl list --json` by name.
# Set JL_NAME to the instance's name (not its numeric id, which rotates on resume).
export JL_NAME="Inferoute-client1"
export JL_GPU=""                 # optional: L4, A100, H100, H200, etc.
# If resume says "L4 not available", cycle these (same region). Comma-separated.
# ./run-cluster.sh linux defaults: JL_GPU=H100, JL_GPU_FALLBACK=H100,H200,
# VLLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct (vLLM only, no Ollama phase)
export JL_GPU_FALLBACK="L4,A5000,RTX6000,A6000"

# Platform URL — reserved ngrok domain (stable; no need to copy from ngrok UI each run)
export INFEROUTE_PLATFORM_URL="https://saussuritic-ordinarily-sheldon.ngrok-free.dev"

# ngrok is USER-MANAGED. The skill only prompts you to start it and verifies
# reachability — it never launches ngrok. Start it yourself before running:
#   ngrok http 80 --host-header=localhost --url=saussuritic-ordinarily-sheldon.ngrok-free.dev

# Consumer API on Mac (inferoute-node docker, port 80)
export INFEROUTE_CONSUMER_URL="http://localhost"

# API keys from inferoute platform
# Single-machine e2e runners (run-e2e-*.sh) use PROVIDER_API_KEY.
export PROVIDER_API_KEY=""
export CONSUMER_API_KEY=""

# Cluster (run-cluster.sh) — one provider account per machine. Must be unique.
# Consumer key above is shared. Do not reuse PROVIDER_API_KEY across machines.
# Linux-only mode (./run-cluster.sh linux) only needs PROVIDER_API_KEY_LINUX.
export PROVIDER_API_KEY_LINUX=""
export PROVIDER_API_KEY_WINDOWS=""
export PROVIDER_API_KEY_MAC=""

# vLLM on JarvisLab
export VLLM_MODEL="Qwen/Qwen2.5-7B-Instruct"

# Model alias — set after client health shows verified model, or use vLLM model id
export INFEROUTE_MODEL_ALIAS="Qwen/Qwen2.5-7B-Instruct"

# vLLM serve flags — must match the catalog serve flags for VLLM_MODEL or the
# client's context gate (live max_model_len >= catalog max_model_len) fails
# verification. Defaults mirror the Qwen2.5 catalog rows: 131072 context via
# YaRN (factor = MAX_MODEL_LEN / ROPE_BASE_LEN) + hermes tool parser, which the
# tool-calling e2e tests (TOOL_TESTS=1, vLLM phase only) depend on.
# NOTE: bf16 7B @ 131072 needs a 48GB GPU (RTX6000/A6000). On 24GB cards
# (L4/A5000) either set VLLM_KV_CACHE_DTYPE="fp8" or lower VLLM_MAX_MODEL_LEN.
export VLLM_MAX_MODEL_LEN="131072"
export VLLM_TOOL_PARSER="hermes"
export VLLM_ROPE_BASE_LEN="32768"   # set "" to skip rope overrides (non-Qwen2.5 models)
export VLLM_KV_CACHE_DTYPE=""       # e.g. "fp8" to fit 131072 on 24GB cards

# Ollama on JarvisLab (second e2e phase). Model must be in the approved list.
# Ollama exposes gguf models to the client as gguf/<model>, so the consumer
# alias for qwen3:0.6b is gguf/qwen3:0.6b.
export OLLAMA_MODEL="qwen3:0.6b"
export OLLAMA_MODEL_ALIAS="gguf/qwen3:0.6b"
export OLLAMA_URL="http://localhost:11434"

# Client config files on JarvisLab (in $JL_CLIENT_DIR).
# config.yaml is generated each run from config.yaml.example using
# PROVIDER_API_KEY + INFEROUTE_PLATFORM_URL. The ollama config is then
# derived from that (same api_key/url, provider_type=ollama).
export CLIENT_CONFIG="config.yaml"
export OLLAMA_CLIENT_CONFIG="config-ollama.yaml"
export VLLM_URL="http://localhost:8000"

# Rebuild the client from source on JarvisLab before testing (scripts/build.sh).
# CLIENT_GIT_PULL=1 hard-resets the JL client dir to origin/$CLIENT_GIT_BRANCH
# first, so every run tests exactly what's on GitHub. Set CLIENT_GIT_PULL=0
# to build the current checkout instead.
export CLIENT_GIT_PULL="1"
export CLIENT_GIT_BRANCH="main"

# Where the Go toolchain lives on JarvisLab. jl exec's non-interactive shell
# doesn't load the login profile, so build.sh can't find `go` without this.
export GO_BIN_DIR="/usr/local/go/bin"

# Phase toggles — set to 0 to skip a backend.
export RUN_VLLM="1"
export RUN_OLLAMA="1"

# JarvisLab persistent paths
export JL_VLLM_BIN="/home/ubuntu/vllm-env/bin/vllm"
export JL_CLIENT_DIR="/home/ubuntu/inferoute-client"   # holds ./inferoute-client; config.yaml is rewritten each run
export JL_REMOTE_LOG_DIR="/home/ubuntu/logs"

# SSH key JarvisLab authorizes. jl exec shells out to ssh, so this key must be
# offered — wire it in ~/.ssh/config for the instance IP range, e.g.:
#   Host 217.18.55.* jarvis-*
#     User ubuntu
#     IdentityFile ~/.ssh/google_1and1
#     IdentitiesOnly yes
export JL_SSH_KEY="$HOME/.ssh/google_1and1"

# NOTE: `jl resume` re-provisions the VM and CHANGES the instance ID + IP.
# That's why the id is resolved from `jl list --json` by JL_NAME each run.

# ── Windows GCE (scripts/e2e-test/run-e2e-windows.sh) ────────────────────────
# Same file is sourced by the Linux and Windows runners. Windows is Ollama-only.
# Instance is started at the beginning of the run and ALWAYS stopped on exit
# unless KEEP=1. Requires gcloud (project inferoute) and OpenSSH on the VM.
export GCE_PROJECT="inferoute"
export GCE_ZONE="us-central1-c"
export GCE_INSTANCE="inferoute-client"
export GCE_EXTERNAL_IP="35.238.4.74"          # static NAT
export WIN_SSH_USER="charles_holtzkampf"
export WIN_SSH_PASSWORD=""   # Windows account password (git-ignored .env only — never commit)
export WIN_HOME="C:/Users/charles_holtzkampf"
export WIN_CLIENT_DIR="C:/Users/charles_holtzkampf/inferoute-client"
export WIN_GO_BIN_DIR="C:/Program Files/Go/bin"
# Optional: override the clone URL used if WIN_CLIENT_DIR is missing on the VM.
# export CLIENT_GIT_REPO="https://github.com/Inferoute/inferoute-client.git"

# ── Mac Mini (scripts/e2e-test/run-e2e-mac.sh) ────────────────────────────────
# Same file is sourced by the Linux/Windows/Mac runners. Mac is Ollama-only.
# SSH password auth (Remote Login). Requires sshpass on the machine running
# the script:  brew install hudochenkov/sshpass/sshpass
# The Mini is NEVER stopped — teardown only kills ollama + inferoute-client
# (KEEP=1 leaves them running).
export MAC_SSH_HOST="192.168.110.124"
export MAC_SSH_USER=""
export MAC_SSH_PASSWORD=""   # git-ignored .env only — never commit
# export MAC_HOME="/Users/<user>"
# export MAC_CLIENT_DIR="/Users/<user>/inferoute-client"
# export MAC_GO_BIN_DIR="/opt/homebrew/bin"   # Apple Silicon Homebrew; Intel: /usr/local/bin
