# Copy to references/.env (same folder). NEVER commit filled secrets.

# JarvisLab — instance id is auto-discovered from `jl list --json` by name.
# Set JL_NAME to the instance's name (not its numeric id, which rotates on resume).
export JL_NAME="Inferoute-client1"
export JL_GPU=""                 # optional: L4, A100, etc.

# Platform URL — reserved ngrok domain (stable; no need to copy from ngrok UI each run)
export INFEROUTE_PLATFORM_URL="https://saussuritic-ordinarily-sheldon.ngrok-free.dev"

# ngrok is USER-MANAGED. The skill only prompts you to start it and verifies
# reachability — it never launches ngrok. Start it yourself before running:
#   ngrok http 80 --host-header=localhost --url=saussuritic-ordinarily-sheldon.ngrok-free.dev

# Consumer API on Mac (inferoute-node docker, port 80)
export INFEROUTE_CONSUMER_URL="http://localhost"

# API keys from inferoute platform
export PROVIDER_API_KEY=""
export CONSUMER_API_KEY=""

# vLLM on JarvisLab
export VLLM_MODEL="Qwen/Qwen3-0.6B"

# Model alias — set after client health shows verified model, or use vLLM model id
export INFEROUTE_MODEL_ALIAS="Qwen/Qwen3-0.6B"

# Ollama on JarvisLab (second e2e phase). Model must be in the approved list.
# Ollama exposes gguf models to the client as gguf/<model>, so the consumer
# alias for qwen3:0.6b is gguf/qwen3:0.6b.
export OLLAMA_MODEL="qwen3:0.6b"
export OLLAMA_MODEL_ALIAS="gguf/qwen3:0.6b"
export OLLAMA_URL="http://localhost:11434"

# Client config files on JarvisLab (in $JL_CLIENT_DIR). The ollama config is
# auto-generated from the vLLM one (same api_key/url, provider_type=ollama).
export CLIENT_CONFIG="config.yaml"
export OLLAMA_CLIENT_CONFIG="config-ollama.yaml"

# Rebuild the client from source on JarvisLab before testing (scripts/build.sh).
# CLIENT_GIT_PULL=1 hard-resets the JL client dir to origin/$CLIENT_GIT_BRANCH
# first, so every run tests exactly what's on GitHub (config.yaml is git-ignored
# and survives). Set CLIENT_GIT_PULL=0 to build the current checkout instead.
export CLIENT_GIT_PULL="1"
export CLIENT_GIT_BRANCH="main"

# Where the Go toolchain lives on JarvisLab. jl exec's non-interactive shell
# doesn't load the login profile, so build.sh can't find `go` without this.
export GO_BIN_DIR="/usr/local/go/bin"

# Phase toggles — set to 0 to skip a backend.
export RUN_VLLM="1"
export RUN_OLLAMA="1"

# JarvisLab persistent paths
export JL_VLLM_BIN="/home/ubuntu/vllm-env/bin/vllm"
export JL_CLIENT_DIR="/home/ubuntu/inferoute-client"   # holds ./inferoute-client + persistent config.yaml
export JL_REMOTE_LOG_DIR="/home/ubuntu/logs"

# SSH key JarvisLab authorizes. jl exec shells out to ssh, so this key must be
# offered — wire it in ~/.ssh/config for the instance IP range, e.g.:
#   Host 217.18.55.* jarvis-*
#     User ubuntu
#     IdentityFile ~/.ssh/google_1and1
#     IdentitiesOnly yes
export JL_SSH_KEY="$HOME/.ssh/google_1and1"

# NOTE: `jl resume` re-provisions the VM and CHANGES the instance ID + IP.
# That's why the id is resolved from `jl list --json` by JL_NAME each run.
